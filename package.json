{
  "name": "@ghosthand/monorepo",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=24"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "apps/testbed/*",
      "packages/*"
    ],
    "catalog": {
      "zod": "4.6.5",
      "@typesafe-ai/sdk": "0.6.0",
      "pino": "10.3.1",
      "playwright-core": "1.63.0",
      "@playwright/test": "1.63.0",
      "hono": "4.13.12",
      "otpauth": "9.5.2",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "vite": "8.3.2",
      "@vitejs/plugin-react": "6.1.1",
      "tailwindcss": "4.3.3",
      "@tailwindcss/vite": "4.3.3",
      "ai": "7.0.126",
      "@ai-sdk/openai": "4.0.83",
      "@ai-sdk/anthropic": "4.0.71",
      "@ai-sdk/google": "4.0.87",
      "@ai-sdk/openai-compatible": "3.0.62",
      "@opentelemetry/api": "1.9.1",
      "@opentelemetry/sdk-trace-base": "2.11.0",
      "@types/node": "26.6.3",
      "@types/bun": "1.4.2",
      "vitest": "4.1.11"
    }
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "scripts": {
    "dev": "node scripts/dev.ts",
    "dev:testbed": "bun run --filter @ghosthand/testbed-server --filter @ghosthand/testbed-web dev",
    "dev:desktop": "bun run --filter @ghosthand/desktop dev",
    "build": "bun run --filter '*' build",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "brand:prepare": "node scripts/prepare-brand.ts",
    "test": "vitest run && bun run --filter @ghosthand/testbed-server test",
    "test:e2e": "bun run --filter @ghosthand/testbed-e2e test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "ghosthand": "node apps/cli/src/main.ts",
    "eval": "node apps/cli/src/main.ts eval",
    "license:check": "node scripts/license-check.ts",
    "secrets:check": "node scripts/secrets-check.ts",
    "probe:jev": "node scripts/probe-jev.ts",
    "probe:codex": "node scripts/probe-codex.ts",
    "probe:claude": "node scripts/probe-claude.ts",
    "probe:planner": "node scripts/probe-planner.ts",
    "models:snapshot": "node scripts/models-snapshot.ts",
    "dist:desktop": "bun run --filter @ghosthand/desktop dist",
    "dist:desktop:appimage": "bun run --filter @ghosthand/desktop dist:appimage",
    "test:desktop": "bun run --filter @ghosthand/desktop test:smoke",
    "mail": "mailpit --listen 127.0.0.1:8025 --smtp 127.0.0.1:1025",
    "changeset": "changeset",
    "smoke:loop": "node scripts/smoke-loop.ts",
    "eval:desktop": "node scripts/eval-desktop.ts",
    "smoke:mcp": "node scripts/mcp-smoke.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@ghosthand/decision-typesafe": "workspace:*",
    "@ghosthand/protocol": "workspace:*",
    "@ghosthand/consultants": "workspace:*",
    "@ghosthand/core": "workspace:*",
    "@ghosthand/models": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "7.0.2",
    "vitest": "catalog:",
    "@ghosthand/engine": "workspace:*",
    "@ghosthand/recorder": "workspace:*",
    "@ghosthand/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "1.31.0"
  }
}
