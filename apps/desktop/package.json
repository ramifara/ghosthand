{
  "name": "@ghosthand/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "GhostHand desktop app (Electron): live view, timeline, approvals, takeover and settings",
  "license": "AGPL-3.0-only",
  "author": "Rami Fara and GhostHand contributors",
  "homepage": "https://github.com/ramifara/ghosthand",
  "type": "module",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml --publish never",
    "dist:appimage": "electron-vite build && electron-builder --config electron-builder.yml --publish never --linux AppImage",
    "test": "vitest run",
    "test:smoke": "electron-vite build && playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "playwright-core": "catalog:"
  },
  "devDependencies": {
    "@ghosthand/core": "workspace:*",
    "@ghosthand/driver-playwright": "workspace:*",
    "@ghosthand/engine": "workspace:*",
    "@ghosthand/models": "workspace:*",
    "@ghosthand/protocol": "workspace:*",
    "@ghosthand/recorder": "workspace:*",
    "@ghosthand/testbed-kit": "workspace:*",
    "@playwright/test": "catalog:",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.41",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "catalog:",
    "clsx": "2.1.1",
    "electron": "43.7.7",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.1",
    "lucide-react": "1.49.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:",
    "zustand": "5.0.15"
  }
}
